<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lane_assist</name>
  <version>0.1.0</version>
  <description>ViT lane assist for F1Tenth: a Vision Transformer turns one camera
  image into a reference path (lane keeping, lane changes around obstacles, stop
  before a full road block) on /planning/ref_path; pure pursuit follows it and a
  3D-lidar safety brake limits the speed. Also holds the offline pipeline (tools/):
  map generation, data collection, labelling and training.</description>
  <maintainer email="jayesh@todo.com">jayesh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- PyTorch (torch) is installed with pip; it has no rosdep key. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
